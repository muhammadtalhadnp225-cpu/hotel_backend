{
  "name": "hotel-erp-backend",
  "version": "1.0.0",
  "description": "Hotel ERP Backend - Node.js, Express, MongoDB Atlas, JWT Authentication",
  "main": "dist/server.cjs",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "esbuild src/server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "postinstall": "npm run build",
    "start": "node dist/server.cjs"
  },
  "keywords": [
    "hotel-erp",
    "express",
    "mongodb",
    "mongoose",
    "jwt",
    "rest-api"
  ],
  "author": "Hotel ERP Software Architecture",
  "license": "ISC",
  "dependencies": {
    "@types/nodemailer": "^8.0.1",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "esbuild": "^0.25.0",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.13.0",
    "nodemailer": "^9.0.5",
    "tsx": "^4.21.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.14.0",
    "nodemon": "^3.1.9",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
