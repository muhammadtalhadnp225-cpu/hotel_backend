# Node.js Server Environment Configuration
PORT=5000
NODE_ENV=production

# Database Connection (MongoDB Atlas)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/hotelerp?retryWrites=true&w=majority

# Security Keys
JWT_SECRET=your_jwt_super_secret_key_change_in_production_2026
JWT_EXPIRES_IN=7d

# CORS & Client Application URL
CORS_ORIGIN=https://hotel-erp-frontend.vercel.app
CLIENT_URL=https://hotel-erp-frontend.vercel.app
